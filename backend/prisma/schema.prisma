// SmartStock – Smart Inventory & Sales Analytics Platform
// Complete Production Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum TransactionType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(CASHIER)
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sales                 Sale[]
  purchases             Purchase[]
  expenses              Expense[]
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]

  @@index([role])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([isActive])
  @@index([name])
}

model Product {
  id            String        @id @default(uuid())
  categoryId    String
  name          String
  sku           String        @unique
  description   String?
  purchasePrice Decimal       @db.Decimal(12, 2)
  sellingPrice  Decimal       @db.Decimal(12, 2)
  currentStock  Int           @default(0)
  reorderLevel  Int           @default(10)
  unit          String        @default("pcs")
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([sku])
  @@index([status])
}

model Supplier {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchases     Purchase[]

  @@index([code])
}

model Customer {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  email       String?
  phone       String?
  address     String?
  creditLimit Decimal  @default(0.00) @db.Decimal(12, 2)
  totalSpent  Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]

  @@index([code])
  @@index([phone])
}

model Purchase {
  id                  String         @id @default(uuid())
  purchaseOrderNumber String         @unique
  supplierId          String
  userId              String
  subtotal            Decimal        @default(0.00) @db.Decimal(12, 2)
  taxAmount           Decimal        @default(0.00) @db.Decimal(12, 2)
  discountAmount      Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount         Decimal        @db.Decimal(12, 2)
  status              PurchaseStatus @default(RECEIVED)
  notes               String?
  purchaseDate        DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([userId])
  @@index([purchaseOrderNumber])
  @@index([status])
  @@index([purchaseDate])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id             String     @id @default(uuid())
  invoiceNumber  String     @unique
  customerId     String?
  userId         String
  subtotal       Decimal    @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]

  @@index([customerId])
  @@index([userId])
  @@index([invoiceNumber])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0.00) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  transactionRef String?
  paidAt         DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paymentMethod])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  productId   String
  userId      String?
  type        TransactionType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  referenceId String?
  notes       String?
  createdAt   DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Expense {
  id            String        @id @default(uuid())
  userId        String
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  description   String
  paymentMethod PaymentMethod @default(CASH)
  isActive      Boolean       @default(true)
  expenseDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([category])
  @@index([paymentMethod])
  @@index([isActive])
  @@index([expenseDate])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
